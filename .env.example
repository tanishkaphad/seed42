# Neon PostgreSQL Connection String (SSL required)
# Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Server Port
PORT=3000
HOST=0.0.0.0

# BullMQ / Redis Connection (Optional - defaults to redis://127.0.0.1:6379)
REDIS_URL=redis://127.0.0.1:6379

# Simulation Settings
DEFAULT_APPROVAL_THRESHOLD=150000

# Groq LLM API Configuration
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Real outbound mail (Resend). MAIL_TO is required for live send — supplier
# seed addresses are never used as the recipient.
RESEND_API_KEY=
MAIL_FROM=Supply Control Room <beth.t@example.com>
MAIL_TO=manasshete2006@gmail.com
# Set true to send live mail to stored contact addresses (not @example.com)
MAIL_SEND_TO_CONTACTS=false
# Optional. If set, POST /webhooks/inbound-email must send x-webhook-secret
MAIL_WEBHOOK_SECRET=

# Watcher flags a shortage when days of coverage is below this value
AGENT_COVERAGE_DAYS=7

# Gmail watch / Pub-Sub boundary (optional). Without these, inbound stays on
# /inbound-email and Resend webhooks — simulation fallback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GMAIL_PUBSUB_TOPIC=
